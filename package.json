{
  "name": "@ankitkumar131/mycode-ai",
  "version": "3.2.1",
  "private": false,
  "description": "Multi-provider AI coding agent for the terminal. Like Claude Code, but provider-agnostic with automatic failover.",
  "type": "module",
  "bin": {
    "mycode": "./bin/mycode.js"
  },
  "files": [
    "bin",
    "packages/cli/dist",
    "scripts"
  ],
  "workspaces": [
    "packages/cli",
    "packages/core",
    "packages/sdk"
  ],
  "scripts": {
    "eval": "node evals/run.mjs",
    "eval:dry": "node evals/run.mjs --dry-run --runs 1",
    "eval:report": "node evals/report.mjs",
    "eval:selftest": "sh evals/lib/selftest.sh",
    "smoke:failover": "node scripts/smoke-failover.mjs",
    "smoke:mock": "node scripts/mock-provider.mjs 4141",
    "smoke:mock-failover": "node scripts/mock-failover-provider.mjs 4242 4243",
    "build": "node scripts/build.mjs",
    "build:cli": "node scripts/build.mjs --package cli",
    "build:core": "node scripts/build.mjs --package core",
    "build:sdk": "node scripts/build.mjs --package sdk",
    "clean": "node scripts/clean.mjs",
    "dev": "node --watch bin/mycode.js chat",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx}'",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'packages/*/src/**/*.{ts,tsx}'",
    "prepublishOnly": "npm run build && npm test",
    "start": "node bin/mycode.js chat",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitkumar131/mycode-ai.git"
  },
  "homepage": "https://github.com/ankitkumar131/mycode-ai#readme",
  "bugs": {
    "url": "https://github.com/ankitkumar131/mycode-ai/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "coding",
    "cli",
    "terminal",
    "openrouter",
    "ollama",
    "nvidia-nim",
    "agent",
    "code-assistant",
    "gemini-cli"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
