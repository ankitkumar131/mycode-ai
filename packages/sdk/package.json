{
  "name": "@mycode/sdk",
  "version": "3.2.1",
  "description": "MyCode SDK \u2014 Programmatic API for MyCode agent",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs --package sdk",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mycode/core": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "prepublishOnly": "npm run build --prefix ../.. && npm test --prefix ../.."
}
