{
  "name": "@mycode/core",
  "version": "3.2.1",
  "description": "MyCode Core \u2014 Agent engine, tools, skills, MCP, and provider system",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs --package core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "diff": "^7.0.0",
    "glob": "^11.0.0",
    "marked": "^14.0.0",
    "ollama": "^0.5.0",
    "openai": "^4.60.0",
    "pdf-parse": "^1.1.1",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "prepublishOnly": "npm run build --prefix ../.. && npm test --prefix ../.."
}
